# cloud-sync configuration. Everything has a working default; the only entries you must
# set are the three Cloudflare credentials. Never commit a filled-in copy.
#
# Local:   node --env-file=.env cloud-sync/sync-anilist.mjs
# GitHub:  credentials as repo Secrets, tuning as repo Variables (see the workflows).

# --- Cloudflare D1 (required) ---------------------------------------------------------
# wrangler d1 list --json  ->  uuid + account_id. The database name also works as an id
# on the modern API, but the uuid is what the token is scoped to.
CF_ACCOUNT_ID=
CF_DATABASE_ID=b352ef74-e863-4278-bee7-e4409afb11bb
# A token with D1:Edit on this one account, nothing more. It can write every row in the
# catalogue, so do not hand it Zone or Pages permissions.
CF_API_TOKEN=

# --- AniList pacing (R2-R7) ----------------------------------------------------------
# Minimum spacing between the START of consecutive AniList requests. 2500ms = 24 req/min,
# under the degraded 30/min. Ignored if it would exceed ANILIST_RATE_CEILING_RPM.
ANILIST_MIN_INTERVAL_MS=2500
# Hard ceiling the client will not let any other setting breach, in requests/minute.
ANILIST_RATE_CEILING_RPM=24
# Entity lookups packed into one aliased GraphQL document (R3). The run reads catalogue
# rows in slices of 4 x this number, so 25 means 100 titles and 4 requests per slice.
# Raise it only if AniList starts rejecting the document as too large.
ANILIST_BATCH_SIZE=25
# Total AniList requests allowed per UTC day, tracked in api_usage (R7). At 24 req/min a
# full 24h of continuous running would be 34,560 — this is the real governor.
ANILIST_DAILY_BUDGET=4000
# Learned-interval cap and the breaker cooldown (R4, R6).
ANILIST_INTERVAL_CAP_MS=30000
ANILIST_BREAKER_COOLDOWN_MS=600000
# Titles read per run before the cursor is saved and the run exits (R9).
MAX_ITEMS_PER_RUN=1000
# How long after a completed pass to start another. Two consecutive runs never reprocess
# the same title; this is what keeps that true while still seeing new seasons.
ANILIST_REWALK_AFTER_MS=86400000

# --- Migration phase ------------------------------------------------------------------
# The sync has three modes, and MODE decides everything else. Set ONE of these styles, not
# both: MODE alone, or the two switches below. An explicit MODE that contradicts the switches
# is refused at startup rather than guessed at, because the difference between the modes is the
# difference between "safe to run beside the local task" and "claiming the local task's columns".
# If you do set MODE by hand, change it in the same edit as any switch below: a leftover MODE that
# now contradicts the switches is a refused startup, not the mode you meant.
#   mirror   (Phase 1, the default) refresh metadata; never insert; never touch sched_*/trend_rank
#   delta    (Phase 2)             as mirror, plus create rows for the sync_pending queue
#   takeover (Phase 3)             also claim sched_* and trend_rank on existing rows
# MODE=mirror
# 1 = the local Windows task AniHubHourlyRefresh is still enabled. This is the truth until you
# actually run `schtasks /Change /TN AniHubHourlyRefresh /DISABLE`, and it must stay 1 through
# Phases 1 and 2: while that task fires, it owns sched_*, trend_rank and every row's
# catalogue_synced_at, and this switch is what keeps the cloud out of those columns.
# Set it to 0 ONLY as part of Phase 3 — disable the task, wait out LEGACY_QUIET_MS below, then
# set this to 0 AND CLOUD_CREATES_ROWS to 1. Setting this to 0 by itself is not a phase: it
# derives a mode whose write set excludes sched_* while saying the only writer that had them is
# stopped, so resolveMode() refuses to start rather than letting the air slots freeze. The error
# names the three ways out (go to Phase 3 properly, put this back to 1, or turn on the fill below).
# Rollback for any phase: gh variable set LEGACY_WRITER_ACTIVE --body '1' -R <owner>/<repo>
# (--body takes a LITERAL string, not a JSON body) and, if you set MODE explicitly,
# gh variable delete MODE -R <owner>/<repo> — then re-enable the task.
LEGACY_WRITER_ACTIVE=1
# 1 = this run may insert an anime row (needs a queue entry in sync_pending). 0 = Phase 1.
# Rollback: gh variable set CLOUD_CREATES_ROWS --body '0' -R <owner>/<repo>
CLOUD_CREATES_ROWS=0
# Genre rows for titles this run creates are always written (a row without them is invisible to
# the browse filters). This switch is about EXISTING rows: 1 lets the cloud replace the genre set
# of a row the local tools never stamped and that has no genres at all. 0 = never touch anyone's
# set. Rows stamped by the local catalogue tools are left alone whatever this says.
# Rollback: gh variable set CLOUD_OWNS_GENRES --body '0' -R <owner>/<repo>
CLOUD_OWNS_GENRES=0
# A safety valve, not a phase. In mirror/delta the sched_* columns belong to the local task, and
# that task walks EVERY row of `anime` each hour (tools/hourly-refresh.mjs:133 selects the whole
# table, not just titles it created), so a row this job inserts gets its air slot refreshed like
# any other — you do not need this switch for Phase 2 to be complete.
# 1 additionally lets the cloud FILL an empty air slot, and only on a row that the local tools
# have never stamped (catalogue_synced_at IS NULL) and whose five sched_* columns are all NULL.
# It never overwrites a populated slot and never clears one, so it cannot flip-flop the shelf; and
# it does not touch trend_rank, which stays entirely the local task's until takeover.
# Turn it on for one case: AniHubHourlyRefresh is broken or disabled while LEGACY_WRITER_ACTIVE
# still says 1. verify.mjs reports that state as "someone still owns the schedule shelf".
# Rollback: gh variable set CLOUD_OWNS_SCHEDULE --body '0' -R <owner>/<repo>
CLOUD_OWNS_SCHEDULE=0
# A takeover refuses to start while the task's own heartbeat in sync_meta is younger than this
# window (2h = one missed tick plus slack), so a forgotten /ENABLE produces exit code 1 and
# exit_reason legacy_still_running instead of two writers on one column. Override for one run
# with `node cloud-sync/sync-anilist.mjs --force-takeover`, which records the decision in
# sync_meta.cloud_takeover rather than silently skipping the check.
# Either way, the first takeover run writes that marker: with the flag it is the proof of your
# decision, without it the instant the quiet window elapsed. verify.mjs compares every row's
# catalogue_synced_at against marker.at, which is how "no local write after the handover" is
# checked against data rather than against a config value someone may have changed since.
LEGACY_QUIET_MS=7200000
# How deep into AniList's global trending list to read for trend_rank, which is what position in
# that list means (schema.sql:18-20). Only paid for by a mode that may write the column. A title
# outside the page gets NULL, never an invented rank.
ANILIST_TRENDING_PAGE_SIZE=50

# --- Transport (R12) -----------------------------------------------------------------
# Set ANILIST_ENDPOINT to https://graphql.anilist.co unless you are debugging.
ANILIST_ENDPOINT=https://graphql.anilist.co
# auto | post | get. 'auto' falls back from POST to GET-through-relay on a non-JSON
# 403/405 — but never on a "manually blocked" 403, because that would be routing around a
# block AniList applied deliberately.
ANILIST_METHOD=auto
# GET-only relay prefix, URL-encoded target appended. Empty means direct.
# Use it for a network path that cannot POST, not to evade a block.
ANILIST_RELAY_PREFIX=
# R13: descriptive UA with a contact route, on every outbound request.
ANILIST_USER_AGENT=AniHubStream/1.0 (catalogue sync; contact: https://anihubstream.com/about)

# --- Kitsu (its own lease and budget) ------------------------------------------------
KITSU_MIN_INTERVAL_MS=45000
KITSU_PAGE_SIZE=20
# The arithmetic for Kitsu: catalog-sync fires 2x daily (0 2,14 * * *), so 4 pages per run
# is 8 requests a day — against Kitsu's ~100 req/hour per IP, well within limits.
KITSU_PAGES_PER_RUN=4
# Leave this unset and the default IS the schedule: KITSU_RUNS_PER_DAY × KITSU_PAGES_PER_RUN + 8.
# Pinning it here would re-create the bug above the moment someone edits KITSU_PAGES_PER_RUN and
# remembers the other number a week later, so it is commented deliberately.
# KITSU_DAILY_BUDGET=200
# The run count the budget derives from — 2 is `0 2,14 * * *` (catalog-sync.yml). A runner cannot ask what cron
# woke it, so this is the schedule written down; config.test.mjs parses catalog-sync.yml and fails if
# the two stop agreeing. Set it only for a local run against a different schedule.
# KITSU_RUNS_PER_DAY=2
KITSU_BASE_URL=https://kitsu.io/api/edge
KITSU_USER_AGENT=AniHubStream/1.0 (catalogue sync; contact: https://anihubstream.com/about)

# --- D1 transport -------------------------------------------------------------------
# Cloudflare's documented statement ceiling is 100,000 bytes; parameter count is the
# binding constraint first (25-column anime rows => 3 rows per statement at 90).
D1_MAX_PARAMS_PER_STATEMENT=90
D1_MAX_SQL_BYTES=90000
# Per-statement HTTP timeout on the D1 REST call. A statement that exceeds it is retried by
# nothing: the run records it and stops, because a write that timed out may still have landed.
D1_TIMEOUT_MS=30000

# --- Report output --------------------------------------------------------------------
# verify.mjs prints an indented object unless this is set, then one line. Set it in a workflow
# log you intend to grep rather than when reading the report by eye.
# QUIET=1

# --- Lease (R8) ----------------------------------------------------------------------
SYNC_LEASE_TTL_MS=1200000
SYNC_LEASE_RENEW_REQUESTS=10
