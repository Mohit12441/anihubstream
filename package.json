{
  "name": "anihubstream",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "node --test api/*.test.mjs tools/*.test.mjs cloud-sync/*.test.mjs",
    "verify": "node tools/verify-runtime.mjs",
    "pages:dev": "npm run build:pages && wrangler pages dev dist-pages --port 8899",
    "preview": "vite preview",
    "serve": "node tools/serve-static.mjs",
    "supervise": "node tools/supervise-origin.mjs"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "lucide-react": "^0.545.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
