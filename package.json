{
  "name": "anihubstream",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode pages --outDir dist-pages --emptyOutDir",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "node --test api/*.test.mjs tools/*.test.mjs cloud-sync/*.test.mjs",
    "verify": "node tools/verify-runtime.mjs",
    "pages:dev": "npm run build:pages && wrangler pages dev dist-pages --port 8899",
    "db:init": "node tools/init-local-db.mjs",
    "preview": "vite preview",
    "serve": "node tools/serve-static.mjs",
    "start:local": "node tools/start-local.mjs",
    "supervise": "node tools/supervise-origin.mjs",
    "meili:setup": "node tools/meilisearch/setup-index.mjs && node tools/meilisearch/sync-meilisearch.mjs",
    "db:seed-id-map": "node tools/apply-id-map.mjs",
    "sync:hianime": "node cloud-sync/sync-hianime.mjs",
    "sync:anilist": "node cloud-sync/sync-anilist.mjs",
    "sync:kitsu": "node cloud-sync/sync-kitsu.mjs",
    "sync:franchises": "node tools/auto-sync-franchises.mjs",
    "sync:schedule": "node tools/sync-ongoing-schedules.mjs",
    "gsc:status": "node tools/gsc-telemetry.mjs",
    "gsc:analytics": "node tools/gsc-telemetry.mjs --analytics",
    "indexnow": "node tools/indexnow.mjs",
    "indexnow:sitemap": "node tools/indexnow.mjs --sitemap"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "lucide-react": "^0.545.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
