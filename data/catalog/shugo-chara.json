      "markers": [],
      "external_id": "44973"
    },
    {
      "n": 2,
      "title": "The Heart's Egg!",
      "runtime": "24:00",
      "runtime_seconds": 1440,
      "thumb": "https://media.kitsu.app/episodes/thumbnails/44974/original.jpg",
      "synopsis": "Nadeshiko Fujisaki, queen of the school, invites Amu to tea at the Royal Garden, where she'd meet the Student Council Guardians. However, during P.E. class, the blue egg begins to hatch, and its' Guardian Character runs away!",
      "airdate": "2007-10-13",
      "markers": [],
      "external_id": "44974"
    },
    {
      "n": 3,
      "title": "Flaky and Fluffy! Leave it to Su!",
      "runtime": "24:00",
      "runtime_seconds": 1440,
      "thumb": "https://media.kitsu.app/episodes/thumbnails/44975/original.jpg",
      "synopsis": "Nadeshiko tells Amu that the two should become friends, but Amu sees it as a trick to get her to join the Guardians. Ikuto Tsukiyomi, the mysterious stranger from last time, interrupts the two and attempts to steal the last of Amu's eggs.",
