  "episodes": [
    {
      "n": 1,
      "title": "Letter",
      "runtime": "5:00",
      "runtime_seconds": 300,
      "thumb": "https://media.kitsu.app/episodes/thumbnails/272582/original.jpg",
      "synopsis": "John is a young boy who’s been hospital-bound from an early age. Ever since he saw his first Pokémon battle on TV, he’s been a big fan of Champion Leon—and he’s dreamed of watching one of Leon’s matches in a stadium. Could a visit from Chairman Rose pave the way for his dreams to come true?",
      "airdate": "2020-01-15",
      "markers": [],
      "external_id": "272582"
    },
    {
      "n": 2,
      "title": "Training",
      "runtime": "5:00",
      "runtime_seconds": 300,
      "thumb": "https://media.kitsu.app/episodes/thumbnails/272583/original.jpg",
      "synopsis": "After losing to Galar’s Champion, Leon, Fighting-type Gym Leader Bea sets out with her Pokémon to elevate their training. Will she find her inner resolve and grow stronger…or will she succumb to the pressure of defeat?",
      "airdate": "2020-02-18",
      "markers": [],
      "external_id": "272583"
    },
    {
      "n": 3,
      "title": "Buddy",
      "runtime": "5:00",
      "runtime_seconds": 300,
      "thumb": "https://media.kitsu.app/episode/272584/thumbnail/03d20dea232187c15e1efaaf4ff0ec0d.png",
      "synopsis": "Hop idolizes his older brother, Leon, who along with his partner Pokémon, Charizard, has earned the title of Champion. Wooloo, Hop’s partner Pokémon, is jealous of the admiration shown for Leon’s Charizard and decides to prove that it’s also worthy of the Champion title.",
      "airdate": "2020-03-17",
      "markers": [],
      "external_id": "272584"
    },
    {
      "n": 4,
      "title": "Early-Evening Waves",
      "runtime": "5:00",
      "runtime_seconds": 300,
      "thumb": "https://media.kitsu.app/episode/272585/thumbnail/f063e84ce60b75e7a1aaa987495730ef.png",
      "synopsis": "Nessa, an incredibly popular Gym Leader and model, has always strived to be the best. Her focus is split between the two professions, and Chairman Rose advises her to choose one path or the other if she truly wants to be number one. Will she sacrifice one dream in pursuit of the other?",
      "airdate": "2020-04-21",
      "markers": [],
      "external_id": "272585"
    },
    {
      "n": 5,
      "title": "Assistant",
      "runtime": "5:00",
      "runtime_seconds": 300,
      "thumb": "https://media.kitsu.app/episode/272586/thumbnail/22b1ca54d92c8189660242e91491f564.png",
      "synopsis": "There’s never a moment’s rest for Oleana as she solves problems big and small to keep Galar running smoothly. But sometimes a break puts everything back in perspective and reminds us why we do what we do.",
      "airdate": "2020-06-04",
      "markers": [],
      "external_id": "272586"
    },
    {
      "n": 6,
      "title": "Moonlight",
      "runtime": "5:00",
      "runtime_seconds": 300,
      "thumb": "https://media.kitsu.app/episode/272587/thumbnail/0712b73f9de543e594dd45f367530f12.png",
      "synopsis": "After getting into an argument with his friend John, Tommy wants to make amends. He enlists Allister, Galar’s Ghost-type Gym Leader, to help in a most unusual way.",
      "airdate": "2020-07-02",
      "markers": [],
      "external_id": "272587"
    },
    {
      "n": 7,
      "title": "Sky",
      "runtime": "5:00",
      "runtime_seconds": 300,
      "thumb": "https://media.kitsu.app/episode/272588/thumbnail/ea5d7b3688c41e3483e6b321d3f09030.png",
      "synopsis": "The day of Leon’s Championship match has arrived, and thanks to John’s letter, all the kids at the hospital are invited to attend! But in his excitement, John oversleeps and almost misses his chance to go to the stadium. Will he be able to make it to the battle in time?",
      "airdate": "2020-08-06",
      "markers": [],
      "external_id": "272588"
    }
  ],
